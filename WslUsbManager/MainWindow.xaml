<Window x:Class="WslUsbManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WslUsbManager.ViewModels"
        Title="WSL USB Manager" Icon="Assets/app.ico" Width="1060" Height="880" MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closed="OnClosed">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- toolbar -->
            <RowDefinition Height="Auto" />   <!-- filters -->
            <RowDefinition Height="*" MinHeight="140" />  <!-- devices -->
            <RowDefinition Height="Auto" />   <!-- device actions -->
            <RowDefinition Height="Auto" />   <!-- arduino -->
            <RowDefinition Height="Auto" />   <!-- splitter -->
            <RowDefinition Height="150" MinHeight="60" />  <!-- log -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="WSL distro:" Style="{StaticResource Label}" />
            <ComboBox Width="170" ItemsSource="{Binding Distros}" SelectedItem="{Binding SelectedDistro}"
                      DisplayMemberPath="Name" ToolTip="Distribution where usbip attach runs and arduino-cli is executed" />
            <TextBlock Text="{Binding DistroStateText}" Foreground="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center" />
            <Button Content="Start" Command="{Binding StartDistroCommand}" MinWidth="56" ToolTip="Start the selected distribution" />
            <CheckBox Content="Auto-attach favorites" IsChecked="{Binding AutoAttachEnabled}" Margin="10,0,0,0"
                      ToolTip="Attach favorite devices flagged 'Auto' as soon as they are plugged in" />

            <Button DockPanel.Dock="Right" Content="Logs" Command="{Binding OpenLogFolderCommand}" Margin="0" MinWidth="56" />
            <Button DockPanel.Dock="Right" Content="settings.ini" Command="{Binding OpenSettingsCommand}" MinWidth="56" />
            <Button DockPanel.Dock="Right" Content="⟳ Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" />
        </DockPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Show:" Style="{StaticResource Label}" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceCountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Arduino" IsChecked="{Binding ShowArduino}" />
                    <CheckBox Content="ESP32" IsChecked="{Binding ShowEsp32}" />
                    <CheckBox Content="STM32" IsChecked="{Binding ShowStm32}" />
                    <CheckBox Content="RP2040 / RP2350" IsChecked="{Binding ShowPico}" />
                    <CheckBox Content="FPGA" IsChecked="{Binding ShowFpga}"
                              ToolTip="Altera/Intel USB-Blaster, Arrow USB Blaster (MAX1000, CYC1000, DECA), Digilent, Xilinx, Lattice, Gowin, Efinix…" />
                    <CheckBox Content="Serial bridges" IsChecked="{Binding ShowSerial}" />
                    <CheckBox Content="Other" IsChecked="{Binding ShowOther}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Devices -->
        <DataGrid Grid.Row="2" x:Name="DeviceGrid"
                  ItemsSource="{Binding DevicesView}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                  BorderBrush="{StaticResource Border}" Background="White" RowHeaderWidth="0"
                  RowHeight="40" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Foreground" Value="#9AA0A6" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="6,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E8F0FE" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Attach to WSL" Command="{Binding AttachCommand}" />
                    <MenuItem Header="Detach" Command="{Binding DetachCommand}" />
                    <Separator />
                    <MenuItem Header="Bind (share)" Command="{Binding BindCommand}" />
                    <MenuItem Header="Bind (force — hide from Windows)" Command="{Binding BindForceCommand}" />
                    <MenuItem Header="Unbind (stop sharing)" Command="{Binding UnbindCommand}" />
                    <Separator />
                    <MenuItem Header="Toggle favorite" Command="{Binding ToggleFavoriteCommand}" />
                    <MenuItem Header="Copy VID:PID" Command="{Binding CopyVidPidCommand}" />
                    <MenuItem Header="Copy instance ID" Command="{Binding CopyInstanceIdCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="34" SortMemberPath="IsFavorite">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}" Cursor="Hand"
                                          ToolTip="Favorite (remembered in settings.ini)" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <TextBlock x:Name="Star" Text="☆" FontSize="17" Foreground="#B0B5BD" Background="Transparent"
                                                   HorizontalAlignment="Center" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Star" Property="Text" Value="★" />
                                                <Setter TargetName="Star" Property="Foreground" Value="#F5B301" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Auto" Width="44" SortMemberPath="AutoAttach">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding AutoAttach, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                      HorizontalAlignment="Center" Focusable="False"
                                      ToolTip="Auto-attach this device to the selected distro when plugged in" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Family / chip" Width="104" SortMemberPath="FamilyText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Family, Converter={StaticResource FamilyBrush}}" CornerRadius="3"
                                    Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FamilyText}" Foreground="White" FontSize="11" FontWeight="SemiBold" FontStyle="Normal" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Device" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Bus ID" Binding="{Binding BusIdText}" Width="62" IsReadOnly="True" />
                <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPid}" Width="84" IsReadOnly="True" FontFamily="Consolas" />
                <DataGridTextColumn Header="COM" Binding="{Binding ComPort}" Width="62" IsReadOnly="True" />
                <DataGridTemplateColumn Header="State" Width="190" SortMemberPath="StateText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding StateKey, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Device actions -->
        <DockPanel Grid.Row="3" Margin="0,8,0,10" LastChildFill="False">
            <Button Content="Attach" Command="{Binding AttachCommand}" Style="{StaticResource PrimaryButton}"
                    ToolTip="Share (if needed) and attach the selected device to WSL" />
            <Button Content="Detach" Command="{Binding DetachCommand}" />
            <Button Content="Bind" Command="{Binding BindCommand}" ToolTip="Share the device (requires administrator approval)" />
            <Button Content="Unbind" Command="{Binding UnbindCommand}" ToolTip="Stop sharing (requires administrator approval)" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="Double-click a row to attach / detach · right-click for more" />
        </DockPanel>

        <!-- Arduino -->
        <GroupBox Grid.Row="4" Padding="8,6" BorderBrush="{StaticResource Border}">
            <GroupBox.Header>
                <TextBlock Text="arduino-cli (inside WSL)" FontWeight="SemiBold" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: port / FQBN -->
                <TextBlock Text="Port" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding BoardPorts}"
                          DisplayMemberPath="Display" TextSearch.TextPath="Address"
                          SelectedItem="{Binding SelectedBoardPort}" Text="{Binding Port, UpdateSourceTrigger=LostFocus}"
                          ToolTip="WSL serial port (/dev/ttyACM0, /dev/ttyUSB0) or a Windows COM port for the 1200-baud reset" />
                <TextBlock Grid.Column="2" Text="FQBN" Style="{StaticResource Label}" Margin="12,0,6,0" />
                <ComboBox Grid.Column="3" IsEditable="True" ItemsSource="{Binding CommonFqbns}"
                          Text="{Binding Fqbn, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Fully Qualified Board Name, with options, e.g. STMicroelectronics:stm32:Nucleo_64:pnum=NUCLEO_F411RE" />
                <Button Grid.Column="4" Content="Detect boards" Command="{Binding DetectBoardsCommand}" Margin="8,0,0,0"
                        ToolTip="arduino-cli board list (inside WSL)" />

                <!-- Row 1: sketch -->
                <TextBlock Grid.Row="1" Text="Sketch" Style="{StaticResource Label}" />
                <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSketchCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding SketchPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sketch folder (Windows or WSL path)" />
                </DockPanel>
                <Button Grid.Row="1" Grid.Column="4" Content="Compile &amp; Upload" Command="{Binding UploadCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,6,0,0" />

                <!-- Row 2: upload method / monitor -->
                <TextBlock Grid.Row="2" Text="Upload" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding UploadMethods}"
                          SelectedItem="{Binding SelectedUploadMethod}">
                    <ComboBox.ToolTip>
                        <TextBlock>
                            Auto: rp2040:* → UF2 copy via Windows; STM32 Nucleo/Discovery → ST-LINK mass storage via Windows;<LineBreak />
                            everything else (AVR, ESP32, STM32 with upload_method=OpenOCDSTLink/swd/dfu…) → arduino-cli upload in WSL.
                        </TextBlock>
                    </ComboBox.ToolTip>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Baud" Style="{StaticResource Label}" Margin="12,6,6,0" />
                <DockPanel Grid.Row="2" Grid.Column="3" Margin="0,6,0,0" LastChildFill="False">
                    <ComboBox Width="90" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding MonitorBaud}" />
                    <Button Content="Serial Monitor" Command="{Binding MonitorCommand}" Margin="6,0,0,0"
                            ToolTip="Opens arduino-cli monitor in a new console window" />
                </DockPanel>
                <Button Grid.Row="2" Grid.Column="4" Content="USB permissions" Command="{Binding InstallUdevRulesCommand}" Margin="8,6,0,0"
                        ToolTip="Install udev rules in WSL for ST-LINK/OpenOCD, RP2040/RP2350 picotool, Black Magic Probe, ESP32 JTAG (asks for sudo)" />

                <!-- Row 3: cores -->
                <TextBlock Grid.Row="3" Text="Core" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding CorePresets}"
                          SelectedItem="{Binding SelectedCore}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,6,0,0" Text="{Binding SelectedCoreNote}"
                           Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Row="3" Grid.Column="4" Content="Install / update" Command="{Binding InstallCoreCommand}" Margin="8,6,0,0"
                        ToolTip="Adds the board-manager URL, updates the index and installs the core inside WSL" />

                <!-- Row 4: free-form arduino-cli -->
                <TextBlock Grid.Row="4" Text="Command" Style="{StaticResource Label}" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Text="{Binding CustomArgs, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" KeyDown="OnCustomArgsKeyDown"
                         ToolTip="Any arduino-cli arguments, e.g.: board listall rp2040   ·   core list   ·   lib install Servo" />
                <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Margin="8,6,0,0">
                    <Button Content="Run" Command="{Binding RunCustomCommand}" MinWidth="50" />
                    <Button Content="Cancel" Command="{Binding CancelArduinoCommand}" MinWidth="56" Margin="0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,4,0,0" />

        <!-- Log -->
        <DockPanel Grid.Row="6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearLog" MinWidth="50" Margin="0" Padding="8,0" MinHeight="20" FontSize="11" />
                <TextBlock Text="Log" Style="{StaticResource SectionHeader}" Margin="0" />
            </DockPanel>
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" Padding="6"
                     VerticalContentAlignment="Top" TextWrapping="NoWrap" />
        </DockPanel>

        <!-- Status -->
        <DockPanel Grid.Row="7" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding UsbipdVersionText}" Foreground="{StaticResource Muted}" />
            <ProgressBar Width="80" Height="8" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <ProgressBar Width="80" Height="8" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#00878F"
                         Visibility="{Binding IsArduinoBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
